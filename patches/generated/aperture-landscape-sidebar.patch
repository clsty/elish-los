+++ b/app/src/main/res/layout-w840dp-h600dp-land/activity_camera.xml
@@ -0,0 +1,424 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!--
+     Layout for a window that is already landscape because the device's natural orientation is
+     landscape (a tablet). The portrait layout pins the control chain to the window's bottom
+     edge, which on such a device cuts 367px off a 1600px tall window and leaves the preview a
+     2.6:1 strip with ~49% of the width lost to letterboxing.
+
+     Here the chain becomes a real sidebar: it runs along the right edge (the charging port
+     side on this tablet) and every control group is stacked vertically, so the buttons are
+     parallel to that edge instead of perpendicular to it. The width is not arbitrary:
+     1600px * 4:3 = 2133px, and 2560 - 2133 = 427px = 190dp, so the preview fills its area
+     with no letterboxing at all.
+
+     Only geometry differs from the portrait layout. The three groups are deliberately not one
+     evenly spaced chain (mode group top, capture group centered, secondary group bottom) so
+     that a changing number of lenses or modes cannot drag the shutter along.
+-->
+<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:id="@+id/mainLayout"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@android:color/black"
+    android:keepScreenOn="true"
+    tools:context=".CameraActivity">
+
+    <!-- Measured from the END edge so the sidebar keeps a fixed physical width regardless of
+         how wide the window is. -->
+    <androidx.constraintlayout.widget.Guideline
+        android:id="@+id/controlPanelGuideline"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        app:layout_constraintGuide_end="190dp" />
+
+    <androidx.camera.view.PreviewView
+        android:id="@+id/viewFinder"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        android:soundEffectsEnabled="false"
+        app:layout_constraintBottom_toBottomOf="parent"
+        app:layout_constraintEnd_toStartOf="@+id/controlPanelGuideline"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintTop_toTopOf="parent"
+        app:scaleType="fitCenter" />
+
+    <org.lineageos.aperture.ui.views.PreviewBlurView
+        android:id="@+id/previewBlurView"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        android:background="@android:color/black"
+        android:scaleType="centerCrop"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder" />
+
+    <ImageView
+        android:id="@+id/viewFinderFocus"
+        android:layout_width="75dp"
+        android:layout_height="75dp"
+        android:src="@drawable/camera_focus_circle"
+        android:visibility="invisible"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder"
+        tools:ignore="ContentDescription" />
+
+    <org.lineageos.aperture.ui.views.GridView
+        android:id="@+id/gridView"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder" />
+
+    <org.lineageos.aperture.ui.views.LevelerView
+        android:id="@+id/levelerView"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder" />
+
+    <org.lineageos.aperture.ui.views.CaptureFrameMaskView
+        android:id="@+id/captureFrameMaskView"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder" />
+
+    <org.lineageos.aperture.ui.views.IslandView
+        android:id="@+id/islandView"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="12dp"
+        android:layout_marginTop="12dp"
+        android:layout_marginEnd="12dp"
+        android:layout_marginBottom="12dp"
+        android:visibility="gone"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder" />
+
+    <org.lineageos.aperture.ui.views.CountDownView
+        android:id="@+id/countDownView"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        android:visibility="invisible"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder" />
+
+    <org.lineageos.aperture.ui.views.HorizontalSlider
+        android:id="@+id/zoomLevel"
+        android:layout_width="250dp"
+        android:layout_height="32dp"
+        android:visibility="gone"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder"
+        app:thumbColor="@android:color/white"
+        app:thumbTextColor="@android:color/black"
+        app:thumbTextSize="10dp"
+        app:trackColor="#7FCCCCCC" />
+
+    <org.lineageos.aperture.ui.views.VerticalSlider
+        android:id="@+id/exposureLevel"
+        android:layout_width="32dp"
+        android:layout_height="250dp"
+        android:layout_marginEnd="8dp"
+        android:visibility="gone"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintTop_toTopOf="@+id/viewFinder"
+        app:thumbColor="@android:color/white"
+        app:thumbTextColor="@android:color/black"
+        app:thumbTextSize="10dp"
+        app:trackBorderColor="#a9a7aa"
+        app:trackColorGradient="true"
+        app:trackColorGradientCenter="#636363"
+        app:trackColorGradientEnd="#242424"
+        app:trackColorGradientStart="#8d9299" />
+
+    <!-- The PRO panel stays a horizontal strip; it belongs to the preview, not to the
+         sidebar, and its slide animation is vertical. -->
+    <HorizontalScrollView
+        android:id="@+id/secondaryTopBarLayout"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:background="#99000000"
+        android:fillViewport="true"
+        android:scrollbars="none"
+        android:visibility="gone"
+        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
+        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
+        app:layout_constraintStart_toStartOf="@+id/viewFinder">
+
+        <LinearLayout
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:gravity="top|center"
+            android:paddingVertical="8dp">
+
+            <!-- Cannot mess with fixed padding from here because of insets -->
+            <Space
+                android:layout_width="16dp"
+                android:layout_height="match_parent" />
+
+            <!-- Photo mode specific settings -->
+            <Button
+                android:id="@+id/aspectRatioButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_aspect_ratio"
+                android:text="@string/aspect_ratio_4_3" />
+
+            <Button
+                android:id="@+id/effectButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_blur_off"
+                android:text="@string/effect_none" />
+
+            <!-- Video mode specific settings -->
+            <Button
+                android:id="@+id/videoQualityButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_hd"
+                android:text="@string/video_quality_fhd" />
+
+            <Button
+                android:id="@+id/videoFrameRateButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_video_frame_rate"
+                android:text="@string/video_framerate_auto" />
+
+            <Button
+                android:id="@+id/videoDynamicRangeButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_hdr_off"
+                android:text="@string/video_dynamic_range_sdr" />
+
+            <Button
+                android:id="@+id/micButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_mic_off"
+                android:text="@string/mic_off" />
+
+            <!-- Common settings -->
+            <Button
+                android:id="@+id/timerButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_timer_off"
+                android:text="@string/timer_off" />
+
+            <Button
+                android:id="@+id/gridButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_grid_3x3_off"
+                android:text="@string/grid_off" />
+
+            <Button
+                android:id="@+id/settingsButton"
+                style="@style/Theme.Aperture.Camera.SecondaryTopBarButton"
+                android:drawableTop="@drawable/ic_settings"
+                android:text="@string/settings" />
+
+            <!-- Cannot mess with fixed padding from here because of insets -->
+            <Space
+                android:layout_width="16dp"
+                android:layout_height="match_parent" />
+
+        </LinearLayout>
+
+    </HorizontalScrollView>
+
+    <!-- Top of the sidebar: camera modes, stacked vertically -->
+    <org.lineageos.aperture.ui.views.CameraModeSelectorLayout
+        android:id="@+id/cameraModeSelectorLayout"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="16dp"
+        android:orientation="vertical"
+        app:layout_constraintEnd_toEndOf="parent"
