diff --git a/app/src/main/java/org/lineageos/aperture/ui/views/CaptureFrameMaskView.kt b/app/src/main/java/org/lineageos/aperture/ui/views/CaptureFrameMaskView.kt
new file mode 100644
index 0000000..89c0ee2
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/ui/views/CaptureFrameMaskView.kt
@@ -0,0 +1,124 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.ui.views
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.util.AttributeSet
+import android.util.Size
+import android.view.View
+
+/**
+ * Dims the parts of the viewfinder that will not be part of the captured media.
+ *
+ * The preview always shows the camera's full field of view. When the active capture
+ * use case has an aspect ratio that differs from the viewfinder's own, the difference
+ * is dimmed and a thin line marks the frame that will actually be captured. Nothing is
+ * drawn when the aspect ratios match or when no capture use case is active.
+ *
+ * This is a presentation-only overlay. It is not clickable, so touches fall through to
+ * the viewfinder underneath.
+ */
+class CaptureFrameMaskView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null
+) : View(context, attrs) {
+
+    private val bandPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(180, 0, 0, 0)
+        style = Paint.Style.FILL
+    }
+
+    private val boundaryPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(230, 255, 255, 255)
+        style = Paint.Style.FILL
+    }
+
+    private val boundaryThickness = 2f * resources.displayMetrics.density
+
+    // Relative aspect ratio difference that is still considered a match
+    private val aspectTolerance = 0.02f
+
+    private var captureResolution: Size? = null
+    private var bandIsHorizontal = false
+    private var bandThickness = 0
+
+    /**
+     * Set the output aspect of the active capture use case, carried as a [Size] (only the
+     * width-to-height ratio is used). Passing null, or a ratio that matches this view,
+     * clears the mask.
+     */
+    fun setCaptureResolution(resolution: Size?) {
+        captureResolution = resolution
+        recomputeBands()
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        recomputeBands()
+    }
+
+    private fun recomputeBands() {
+        val resolution = captureResolution
+        if (resolution == null || resolution.width <= 0 || resolution.height <= 0 ||
+            width <= 0 || height <= 0) {
+            bandThickness = 0
+            invalidate()
+            return
+        }
+
+        val captureAspect = resolution.width.toFloat() / resolution.height
+        val viewAspect = width.toFloat() / height
+        bandThickness = when {
+            kotlin.math.abs(captureAspect - viewAspect) / viewAspect < aspectTolerance -> 0
+            captureAspect > viewAspect -> {
+                bandIsHorizontal = true
+                ((height - width / captureAspect) / 2f).toInt().coerceAtLeast(0)
+            }
+            else -> {
+                bandIsHorizontal = false
+                ((width - height * captureAspect) / 2f).toInt().coerceAtLeast(0)
+            }
+        }
+        invalidate()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (bandThickness <= 0) {
+            return
+        }
+        if (bandIsHorizontal) {
+            canvas.drawRect(0f, 0f, width.toFloat(), bandThickness.toFloat(), bandPaint)
+            canvas.drawRect(
+                0f, (height - bandThickness).toFloat(), width.toFloat(), height.toFloat(), bandPaint
+            )
+            canvas.drawRect(
+                0f, bandThickness.toFloat(), width.toFloat(),
+                bandThickness + boundaryThickness, boundaryPaint
+            )
+            canvas.drawRect(
+                0f, (height - bandThickness).toFloat() - boundaryThickness, width.toFloat(),
+                (height - bandThickness).toFloat(), boundaryPaint
+            )
+        } else {
+            canvas.drawRect(0f, 0f, bandThickness.toFloat(), height.toFloat(), bandPaint)
+            canvas.drawRect(
+                (width - bandThickness).toFloat(), 0f, width.toFloat(), height.toFloat(), bandPaint
+            )
+            canvas.drawRect(
+                bandThickness.toFloat(), 0f, bandThickness + boundaryThickness,
+                height.toFloat(), boundaryPaint
+            )
+            canvas.drawRect(
+                (width - bandThickness).toFloat() - boundaryThickness, 0f,
+                (width - bandThickness).toFloat(), height.toFloat(), boundaryPaint
+            )
+        }
+    }
+}
diff --git a/app/src/main/res/layout-w840dp-h600dp-land/activity_camera.xml b/app/src/main/res/layout-w840dp-h600dp-land/activity_camera.xml
