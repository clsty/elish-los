+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <hardware/sensors.h>
+
+namespace android {
+
+/*
+ * Boundary transform between two device coordinate frames.
+ *
+ * The sensor implementation (here: the SLPI firmware and its HAL) reports in
+ * the vendor's original frame, which is the panel's *unrotated* frame. When
+ * the panel is installed rotated -- ro.surface_flinger.primary_display_orientation
+ * is not ORIENTATION_0 -- the natural orientation that the framework and every
+ * client reason about is a frame rotated relative to that, and nothing in
+ * Android propagates the install orientation into SensorEvent.values. Clients
+ * that derive a tilt from gravity then end up off by exactly that angle: auto
+ * rotation, a camera app placing its controls, a compass.
+ *
+ * So: convert once, at the single place where HAL events enter the framework
+ * (SensorDevice::poll()), and publish one public device frame -- fixed to the
+ * installed natural orientation, independent of the current display rotation.
+ * Nothing downstream has to know about it, including the virtual sensors that
+ * SensorService computes from these very events, which is why the transform is
+ * deliberately *not* applied again at the delivery end.
+ *
+ * Both directions are exposed, because injection goes the other way: a client
+ * injects in the public frame, the HAL expects its own, and poll() converts
+ * back, so an injected value comes out unchanged.
+ *
+ * When the install orientation is ORIENTATION_0 or unset -- every device that
+ * was not built this way -- both entry points are no-ops and nothing is
+ * logged.
+ */
+class DeviceFrameTransform {
+public:
+    DeviceFrameTransform();
+
+    // HAL frame -> public frame. For events returned by SensorDevice::poll().
+    void toPublicFrame(sensors_event_t* event) const;
+
+    // Public frame -> HAL frame. For events passed to the HAL by
+    // SensorDevice::injectSensorData().
+    void toHalFrame(sensors_event_t* event) const;
+
+    bool isEnabled() const {
+        return mInstallDegrees != 0;
+    }
+
+    // The install orientation this transform was built for, in degrees.
+    int installDegrees() const {
+        return mInstallDegrees;
+    }
+
+private:
+    void apply(sensors_event_t* event, bool toPublic) const;
+
+    int mInstallDegrees = 0;
+    // The basis change is a rotation about the panel normal: cos and sin of
+    // the install angle are all that is needed.
+    float mCos = 1.0f;
+    float mSin = 0.0f;
+    // How far TYPE_DEVICE_ORIENTATION moves, in quarter turns.
+    int mEnumStep = 0;
+};
+
+}  // namespace android
