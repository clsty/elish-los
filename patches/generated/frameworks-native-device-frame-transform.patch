+#include "DeviceFrameTransform.h"
+
+#include <android-base/properties.h>
+#include <log/log.h>
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+namespace android {
+namespace {
+
+constexpr char kInstallOrientationProp[] = "ro.surface_flinger.primary_display_orientation";
+
+double radians(double degrees) {
+    return degrees * M_PI / 180.0;
+}
+
+double degreesFrom(double radiansValue) {
+    return radiansValue * 180.0 / M_PI;
+}
+
+// The property is an enum, not a number.
+int installDegreesFromProperty() {
+    const std::string value = android::base::GetProperty(kInstallOrientationProp, "");
+    if (value == "ORIENTATION_90") {
+        return 90;
+    } else if (value == "ORIENTATION_180") {
+        return 180;
+    } else if (value == "ORIENTATION_270") {
+        return 270;
+    }
+    // ORIENTATION_0, unset, or a value we do not recognise: publish the HAL frame as is.
+    return 0;
+}
+
+}  // namespace
+
+DeviceFrameTransform::DeviceFrameTransform() {
+    mInstallDegrees = installDegreesFromProperty();
+    if (mInstallDegrees == 0) {
+        return;
+    }
+    mCos = static_cast<float>(std::cos(radians(mInstallDegrees)));
+    mSin = static_cast<float>(std::sin(radians(mInstallDegrees)));
+    // A pose whose top edge is the frame's +Y is ROTATION_0. Rotating the frame
+    // the panel is installed by moves that pose backwards through the enum: in
+    // a frame installed 90 degrees counter-clockwise it is ROTATION_3.
+    mEnumStep = (4 - mInstallDegrees / 90) & 3;
+    ALOGI("Panel installed at %d degrees: publishing one public device frame, "
+          "v_public = Rz(+%d) * v_hal, TYPE_DEVICE_ORIENTATION step %+d",
+          mInstallDegrees, mInstallDegrees, mEnumStep);
+}
+
+void DeviceFrameTransform::toPublicFrame(sensors_event_t* event) const {
+    apply(event, true);
+}
+
+void DeviceFrameTransform::toHalFrame(sensors_event_t* event) const {
+    apply(event, false);
+}
+
+void DeviceFrameTransform::apply(sensors_event_t* event, bool toPublic) const {
+    if (event == nullptr || mInstallDegrees == 0) {
+        return;
+    }
+
+    // The basis change is Rz(+install) going out to clients and its transpose
+    // coming back from them, which is the same rotation with the sine flipped.
+    const float c = mCos;
+    const float s = toPublic ? mSin : -mSin;
+
+    switch (event->type) {
+        case SENSOR_TYPE_ACCELEROMETER:
+        case SENSOR_TYPE_GRAVITY:
+        case SENSOR_TYPE_LINEAR_ACCELERATION:
+        case SENSOR_TYPE_GYROSCOPE:
+        case SENSOR_TYPE_MAGNETIC_FIELD:
+        case SENSOR_TYPE_ACCELEROMETER_UNCALIBRATED:
+        case SENSOR_TYPE_GYROSCOPE_UNCALIBRATED:
+        case SENSOR_TYPE_MAGNETIC_FIELD_UNCALIBRATED: {
+            const auto rotateVec3 = [c, s](float* v) {
+                const float x = v[0];
+                const float y = v[1];
+                v[0] = c * x - s * y;
+                v[1] = s * x + c * y;
+                // The panel is not flipped over, so v[2] stays as it is.
+            };
+            rotateVec3(event->data);
+            // The uncalibrated variants carry their bias estimate in data[3..5],
+            // in the same frame as data[0..2]: M(v - b) == Mv - Mb, so both
+            // halves have to move together or the bias stops meaning anything.
+            if (event->type == SENSOR_TYPE_ACCELEROMETER_UNCALIBRATED ||
+                event->type == SENSOR_TYPE_GYROSCOPE_UNCALIBRATED ||
+                event->type == SENSOR_TYPE_MAGNETIC_FIELD_UNCALIBRATED) {
+                rotateVec3(event->data + 3);
+            }
+            break;
+        }
+
+        case SENSOR_TYPE_ROTATION_VECTOR:
+        case SENSOR_TYPE_GAME_ROTATION_VECTOR:
+        case SENSOR_TYPE_GEOMAGNETIC_ROTATION_VECTOR: {
+            // Android stores these as (x, y, z, w) and the matrix they describe
+            // maps a device vector onto the world frame, so a change of the
+            // device basis is a right-multiplication by that basis, not a
+            // conjugation: the world frame is not ours to rotate.
+            const double half = 0.5 * radians(toPublic ? -mInstallDegrees : mInstallDegrees);
+            const float qc = static_cast<float>(std::cos(half));
+            const float qs = static_cast<float>(std::sin(half));
+
+            const float x = event->data[0];
+            const float y = event->data[1];
+            const float z = event->data[2];
+            const float w = event->data[3];
+            // Hamilton product with (0, 0, qs, qc). data[4], where a heading
+            // accuracy may sit, is left alone, and so is the sign of w:
+            // normalising it here would introduce jumps.
+            event->data[0] = qc * x + qs * y;
+            event->data[1] = qc * y - qs * x;
+            event->data[2] = qc * z + qs * w;
+            event->data[3] = qc * w - qs * z;
+            break;
+        }
+
+        case SENSOR_TYPE_ORIENTATION: {
+            // OrientationSensor.cpp, the AOSP implementation of this type,
+            // extracts the three angles from a world->device matrix A as
+            //     azimuth = atan2(-A[0][1], A[0][0])
+            //     pitch   = atan2(-A[1][2], A[2][2])
+            //     roll    = asin( A[0][2])
+            // (that source indexes its mat33_t by column) and A is built as
+            // Rx(pitch) * Ry(roll) * Rz(azimuth). Changing the device basis
+            // left-multiplies A by Rz(+install), which only mixes the two rows
+            // the extraction reads. Verified to agree with the closed form for a
+            // 90 degree install angle, and to be its own inverse going back.
+            const double cc = c;
+            const double ss = s;
+            const double az = radians(event->data[0]);
+            const double pitch = radians(event->data[1]);
+            const double roll = radians(event->data[2]);
+
+            const double ca = std::cos(az), sa = std::sin(az);
+            const double cp = std::cos(pitch), sp = std::sin(pitch);
+            const double cr = std::cos(roll), sr = std::sin(roll);
+
+            const double a00 = cr * ca, a01 = -cr * sa, a02 = sr;
+            const double a10 = cp * sa + sp * sr * ca;
+            const double a11 = cp * ca - sp * sr * sa;
+            const double a12 = -sp * cr;
+            const double a22 = cp * cr;
+
+            double newAz = degreesFrom(std::atan2(-(cc * a01 - ss * a11), cc * a00 - ss * a10));
+            newAz = std::fmod(newAz + 360.0, 360.0);
+            const double newPitch = degreesFrom(std::atan2(-(ss * a02 + cc * a12), a22));
+            const double newRoll =
+                    degreesFrom(std::asin(std::clamp(cc * a02 - ss * a12, -1.0, 1.0)));
+
+            event->data[0] = static_cast<float>(newAz);
+            event->data[1] = static_cast<float>(newPitch);
+            event->data[2] = static_cast<float>(newRoll);
+            break;
+        }
+
+        case SENSOR_TYPE_DEVICE_ORIENTATION: {
+            // Not a vector: a quantised pose, an index 0..3 for which edge of
+            // the panel is up. It needs its own step, and it matters more than
+            // the vectors do, because WindowOrientationListener prefers this
+            // sensor when it exists, so auto rotation reads exactly this number.
+            const float value = event->data[0];
+            if (value >= 0.0f && value <= 3.0f && value == std::floor(value)) {
+                const int step = toPublic ? mEnumStep : ((4 - mEnumStep) & 3);
+                event->data[0] = static_cast<float>((static_cast<int>(value) + step) & 3);
+            }
+            break;
+        }
+
+        default:
+            // Scalars, metadata (flush complete, dynamic sensor connect),
+            // additional info and vendor private types are left alone. Additional
+            // info in particular is not simply a vector: sensor placement and
+            // calibration matrices name their own frames.
+            break;
+    }
+}
+
+}  // namespace android
